                } else {
                    barkIcon.className = 'p-2.5 bg-cyan-500/10 border border-cyan-500/30 rounded-xl text-cyan-400 transition-all duration-500';
                    barkIcon.innerHTML = '<i data-lucide="crosshair" class="w-6 h-6"></i>';
                    lucide.createIcons();
