        }
        function playBeep(freq, duration) {
            initAudio();
            const oscillator = audioCtx.createOscillator();
            const gainNode = audioCtx.createGain();
            oscillator.type = 'sine';
            oscillator.frequency.value = freq;
            oscillator.connect(gainNode);
            gainNode.connect(audioCtx.destination);
            gainNode.gain.setValueAtTime(0.1, audioCtx.currentTime);
            oscillator.start();
            setTimeout(() => oscillator.stop(), duration);
        }

        const ctx = document.getElementById('velocityChart').getContext('2d');
        const velocityChart = new Chart(ctx, {
            type: 'line',
            data: { labels: Array(25).fill(''), datasets: [{ data: Array(25).fill(0), borderColor: '#10b981', borderWidth: 2, tension: 0.3, fill: true, backgroundColor: 'rgba(16, 185, 129, 0.08)', pointRadius: 0 }] },
            options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } }, scales: { x: { display: false }, y: { min: 0, max: 5, grid: { color: 'rgba(255,255,255,0.05)' }, ticks: { color: '#64748b' } } } }
        });

        async function setTurretMode(mode) { 
            initAudio();
            await fetch('/api/turret/mode', { method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify({mode}) }); 
        }
        async function toggleHeatmap() { await fetch('/api/turret/heatmap', { method: 'POST' }); }
        
        function updateAimText() { 
            document.getElementById('angle-val').innerText = `${document.getElementById('angle-slider').value}°`; 
            document.getElementById('dist-val').innerText = `${document.getElementById('dist-slider').value} FT`; 
