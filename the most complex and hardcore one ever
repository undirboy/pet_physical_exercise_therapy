# 3. BACKGROUND THREADS (DVR, AUDIO FFT, MAC HEALTH)
# ==========================================
def export_highlight_video(frames_to_save):
    filename = f"highlights/sprint_{int(time.time())}.mp4"
    fourcc = cv2.VideoWriter_fourcc(*'mp4v')
    out = cv2.VideoWriter(filename, fourcc, 30.0, (640, 480))
    for f in frames_to_save: out.write(f)
    out.release()
    print(f"[+] DVR Saved: {filename}")

def audio_monitor_thread():
    if not AUDIO_ENABLED: return
    
    def audio_callback(indata, frames, time_info, status):
        audio_data = indata[:, 0]
        fft_data = np.abs(np.fft.rfft(audio_data))
        freqs = np.fft.rfftfreq(len(audio_data), 1.0/44100)
        
        volume_norm = np.linalg.norm(audio_data) * 10
        if volume_norm > 40.0:
            dominant_freq = freqs[np.argmax(fft_data)]
            if 500 < dominant_freq < 3000:
                # [BUG FIX] Atomic dict update - no lock used, prevents audio crash
                telemetry_state["bark_detected"] = True

    try:
        with sd.InputStream(callback=audio_callback, samplerate=44100, channels=1):
            # [BUG FIX] UI flash delay pulled outside of lock to prevent video freeze
            while True:
                time.sleep(0.1) 
                if telemetry_state["bark_detected"]:
                    time.sleep(1.0) 
                    with state_lock:
                        telemetry_state["bark_detected"] = False
    except Exception:
        print("[-] Audio monitor failed to start (Check Mac Mic Permissions).")

def system_monitor_thread():
    while True:
        cpu = psutil.cpu_percent(interval=1)
        ram = psutil.virtual_memory().percent
        with state_lock:
            telemetry_state["cpu_usage"] = cpu
            telemetry_state["ram_usage"] = ram
        time.sleep(2)

