        async function fireTurret() { await fetch('/api/turret/fire', { method: 'POST' }); }
        async function refillTurret() { await fetch('/api/turret/refill', { method: 'POST' }); }

        let previousMode = 'MANUAL';

        async function syncTelemetry() {
            try {
                const res = await fetch('/api/telemetry');
                const data = await res.json();
                const body = document.getElementById('app-body');
                const badge = document.getElementById('mode-badge');
                
                if (data.turret_mode === 'AUTO_LURE' && previousMode === 'MANUAL') {
                    playBeep(880, 150); 
                    setTimeout(() => playBeep(1108, 250), 200); 
                }
                previousMode = data.turret_mode;
                
                if (data.night_mode) {
                    body.classList.add('night-dim');
                    badge.innerText = "NIGHT STANDBY MODE";
                } else {
                    body.classList.remove('night-dim');
                    badge.innerHTML = data.turret_mode === 'AUTO_LURE' ? '<span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span> AUTO LURE PATROL' : '<span class="w-2 h-2 rounded-full bg-cyan-400 animate-ping"></span> MANUAL AIM';
                }

                const barkIcon = document.getElementById('bark-icon');
                if (data.bark_detected) {
                    barkIcon.className = 'p-2.5 bg-yellow-500 border border-yellow-300 rounded-xl text-black shadow-lg shadow-yellow-500/50 scale-110 transition-all';
                    barkIcon.innerHTML = '<i data-lucide="mic" class="w-6 h-6"></i>';
