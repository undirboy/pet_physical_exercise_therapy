# [BUG FIX] Added check_same_thread=False to all connections

def init_db():
    conn = sqlite3.connect('pitpaws_data.db', check_same_thread=False)
    c = conn.cursor()
    c.execute('''CREATE TABLE IF NOT EXISTS daily_stats
                 (date TEXT PRIMARY KEY, top_speed REAL, fastest_lap REAL, falls INTEGER)''')
    conn.commit()
    conn.close()

def load_db_stats():
    today = str(date.today())
    conn = sqlite3.connect('pitpaws_data.db', check_same_thread=False)
    c = conn.cursor()
    c.execute("SELECT top_speed, fastest_lap, falls FROM daily_stats WHERE date=?", (today,))
    row = c.fetchone()
    conn.close()
    if row:
        with state_lock:
            telemetry_state["top_sprint_mps"] = row[0]
            telemetry_state["fastest_lap_sec"] = row[1]
            telemetry_state["fall_count"] = row[2]

def update_db_stats():
    today = str(date.today())
    with state_lock:
        top = telemetry_state["top_sprint_mps"]
        lap = telemetry_state["fastest_lap_sec"]
        falls = telemetry_state["fall_count"]
    
    conn = sqlite3.connect('pitpaws_data.db', check_same_thread=False)
    c = conn.cursor()
    c.execute("INSERT OR REPLACE INTO daily_stats (date, top_speed, fastest_lap, falls) VALUES (?, ?, ?, ?)", 
              (today, top, lap, falls))
    conn.commit()
    conn.close()

