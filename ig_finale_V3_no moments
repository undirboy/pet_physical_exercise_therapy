def init_db():
    conn = sqlite3.connect(DB_PATH, check_same_thread=False)
    c = conn.cursor()
    c.execute('''CREATE TABLE IF NOT EXISTS daily_stats
                 (date TEXT PRIMARY KEY, top_speed REAL, fastest_lap REAL, falls INTEGER)''')
    try:
        c.execute("ALTER TABLE daily_stats ADD COLUMN treats INTEGER DEFAULT 0")
    except sqlite3.OperationalError:
        pass
    try:
        c.execute("ALTER TABLE daily_stats ADD COLUMN limp_delta_val REAL DEFAULT 0.0")
    except sqlite3.OperationalError:
        pass
        
    c.execute('''CREATE TABLE IF NOT EXISTS profiles 
                 (species TEXT PRIMARY KEY, name TEXT, birthday TEXT)''')
    c.execute("INSERT OR IGNORE INTO profiles (species, name, birthday) VALUES ('Dog', 'Carbon', '')")
    c.execute("INSERT OR IGNORE INTO profiles (species, name, birthday) VALUES ('Cat', 'Kitty', '')")
    c.execute("INSERT OR IGNORE INTO profiles (species, name, birthday) VALUES ('Human', 'Owner', '')")
    conn.commit()
    conn.close()

def load_db_stats():
    today = str(date.today())
    conn = sqlite3.connect(DB_PATH, check_same_thread=False)
    c = conn.cursor()
    try:
        c.execute("SELECT top_speed, fastest_lap, falls, treats, limp_delta_val FROM daily_stats WHERE date=?", (today,))
        row = c.fetchone()
        if row:
            with state_lock:
                telemetry_state["top_sprint_mps"] = row[0]
                telemetry_state["fastest_lap_sec"] = row[1]
                telemetry_state["fall_count"] = row[2]
                telemetry_state["treats_dispensed_today"] = row[3] if row[3] is not None else 0
                telemetry_state["limp_delta"] = row[4] if row[4] is not None else 0.0
                
        c.execute("SELECT limp_delta_val FROM daily_stats WHERE date < ? ORDER BY date DESC LIMIT 1", (today,))
        prev_row = c.fetchone()
        if prev_row and prev_row[0] is not None:
            with state_lock:
                telemetry_state["prev_day_asymmetry"] = prev_row[0]
    except Exception as e:
        print(f"[-] Error loading DB stats: {e}")
            
    c.execute("SELECT species, name, birthday FROM profiles")
    for row in c.fetchall():
        with state_lock:
            pet_profiles[row[0]] = {"name": row[1], "birthday": row[2]}
    conn.close()

def update_db_stats():
    today = str(date.today())
    with state_lock:
        top = telemetry_state["top_sprint_mps"]
        lap = telemetry_state["fastest_lap_sec"]
        falls = telemetry_state["fall_count"]
        treats = telemetry_state["treats_dispensed_today"]
        limp_val = telemetry_state["limp_delta"]

    max_retries = 5
    for attempt in range(max_retries):
        try:
            conn = sqlite3.connect(DB_PATH, check_same_thread=False)
            c = conn.cursor()
            c.execute("""INSERT OR REPLACE INTO daily_stats (date, top_speed, fastest_lap, falls, treats, limp_delta_val) 
                         VALUES (?, ?, ?, ?, ?, ?)""", 
                      (today, top, lap, falls, treats, limp_val))
            conn.commit()
            conn.close()
            break
        except sqlite3.OperationalError as e:
            if "database is locked" in str(e) and attempt < max_retries - 1:
                time.sleep(0.1 * (attempt + 1))
            else:
                print(f"[-] Database Error in update_db_stats: {e}")
        except Exception as e:
            print(f"[-] Unexpected DB Error: {e}")
            break

def update_pet_profile_db(species, name, birthday):
    with state_lock:
        pet_profiles[species] = {"name": name, "birthday": birthday}
    max_retries = 5
    for attempt in range(max_retries):
        try:
            conn = sqlite3.connect(DB_PATH, check_same_thread=False)
            c = conn.cursor()
            c.execute("INSERT OR REPLACE INTO profiles (species, name, birthday) VALUES (?, ?, ?)", (species, name, birthday))
            conn.commit()
            conn.close()
            break
        except sqlite3.OperationalError as e:
            if "database is locked" in str(e) and attempt < max_retries - 1:
                time.sleep(0.1)
            else:
                print(f"[-] Database Error in update_pet_profile_db: {e}")
                break

