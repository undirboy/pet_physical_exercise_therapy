def init_ai_model():
    proto = os.path.join(BASE_DIR, "MobileNetSSD.prototxt")
    model = os.path.join(BASE_DIR, "MobileNetSSD.caffemodel")
    
    if not os.path.exists(proto) or not os.path.exists(model):
        print("[*] Downloading MobileNet-SSD AI Models (One-time setup ~23MB)...")
        try:
            urllib.request.urlretrieve("https://raw.githubusercontent.com/chuanqi305/MobileNet-SSD/master/MobileNetSSD_deploy.prototxt", proto)
            urllib.request.urlretrieve("https://github.com/chuanqi305/MobileNet-SSD/blob/master/MobileNetSSD_deploy.caffemodel?raw=true", model)
            
            if os.path.getsize(model) < 1000000:
                print("[-] AI Download failed: Corrupted file received. Cleaning up.")
                os.remove(proto)
                os.remove(model)
                return None
                
            print("[+] AI Download Complete!")
        except Exception as e:
            print(f"[-] AI Download failed: {e}. Falling back to standard motion tracking.")
            if os.path.exists(proto): os.remove(proto)
            if os.path.exists(model): os.remove(model)
            return None
    try:
        net = cv2.dnn.readNetFromCaffe(proto, model)
        print("[+] Neural Network Entity Detection Loaded.")
        return net
    except:
        return None

ai_net = init_ai_model()

