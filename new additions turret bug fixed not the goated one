                    <div class="text-2xl font-extrabold text-white mt-0.5 mono"><span id="treat-remaining">20</span><span class="text-slate-500 text-xs"> / 25</span></div>
                </div>
                <button onclick="refillTurret()" class="py-2 px-4 bg-slate-800 text-slate-300 text-xs font-semibold rounded-lg border border-slate-700 active:scale-95">
                    REFILL
                </button>
            </div>
        </div>
    </main>

    <script>
        lucide.createIcons();
        if ('serviceWorker' in navigator) navigator.serviceWorker.register('/sw.js');

        let audioCtx;
        function initAudio() {
            if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        }
        function playBeep(freq, duration) {
            initAudio();
            const oscillator = audioCtx.createOscillator();
            const gainNode = audioCtx.createGain();
            oscillator.type = 'sine';
            oscillator.frequency.value = freq;
            oscillator.connect(gainNode);
            gainNode.connect(audioCtx.destination);
            gainNode.gain.setValueAtTime(0.1, audioCtx.currentTime); 
            oscillator.start();
            setTimeout(() => oscillator.stop(), duration);
        }

        const ctx = document.getElementById('velocityChart').getContext('2d');
        const velocityChart = new Chart(ctx, {
            type: 'line',
            data: {
                labels: Array(25).fill(''),
                datasets: [{
                    label: 'Velocity m/s',
                    data: Array(25).fill(0),
                    borderColor: '#10b981',
                    borderWidth: 2,
                    tension: 0.3,
                    fill: true,
                    backgroundColor: 'rgba(16, 185, 129, 0.08)',
                    pointRadius: 0
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: {
                    x: { display: false },
                    y: { min: 0, max: 5, grid: { color: 'rgba(255,255,255,0.05)' }, ticks: { color: '#64748b', font: { family: 'JetBrains Mono' } } }
                }
            }
        });

        async function setTurretMode(mode) {
            initAudio(); 
            try {
                await fetch('/api/turret/mode', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ mode })
                });
            } catch (err) {}
        }

        function updateAimText() {
            const angle = document.getElementById('angle-slider').value;
            const distance = document.getElementById('dist-slider').value;
            document.getElementById('angle-val').innerText = `${angle}° (${angle == 90 ? 'CENTER' : (angle < 90 ? 'LEFT' : 'RIGHT')})`;
            document.getElementById('dist-val').innerText = `${distance} FT`;
        }

        async function updateAim() {
            const angle = document.getElementById('angle-slider').value;
            const distance = document.getElementById('dist-slider').value;
            try {
                await fetch('/api/turret/aim', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ angle, distance })
                });
            } catch (e) {}
        }

        async function fireTurret() {
            try { await fetch('/api/turret/fire', { method: 'POST' }); } catch (err) {}
        }

        async function refillTurret() {
            try { await fetch('/api/turret/refill', { method: 'POST' }); } catch (err) {}
        }

        let previousMode = 'MANUAL';

        async function syncTelemetry() {
            try {
                const res = await fetch('/api/telemetry');
                const data = await res.json();

                const manualBtn = document.getElementById('btn-manual');
                const autoBtn = document.getElementById('btn-auto');
                const badge = document.getElementById('mode-badge');
                const vidContainer = document.getElementById('video-container');
                const camLabel = document.getElementById('camera-label');

                if (data.turret_mode === 'AUTO_LURE' && previousMode === 'MANUAL') {
                    playBeep(880, 150); 
                    setTimeout(() => playBeep(1108, 250), 200); 
                }
                previousMode = data.turret_mode;

                if (data.turret_mode === 'AUTO_LURE') {
                    autoBtn.className = 'py-3 px-3 rounded-xl border border-emerald-500/40 bg-emerald-500/20 text-emerald-300 font-semibold text-[10px] sm:text-xs transition';
                    manualBtn.className = 'py-3 px-3 rounded-xl border border-slate-700 bg-slate-800 text-slate-400 font-semibold text-[10px] sm:text-xs hover:border-slate-600 transition';
                    badge.className = 'flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-[10px] sm:text-xs font-semibold';
                    badge.innerHTML = '<span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span> AUTO LURE PATROL';
                    
                    document.getElementById('angle-slider').value = data.turret_angle_deg;
                    document.getElementById('dist-slider').value = data.launch_distance_ft;
                    updateAimText();
                } else {
                    manualBtn.className = 'py-3 px-3 rounded-xl border border-cyan-500/40 bg-cyan-500/20 text-cyan-300 font-semibold text-[10px] sm:text-xs transition';
                    autoBtn.className = 'py-3 px-3 rounded-xl border border-slate-700 bg-slate-800 text-slate-400 font-semibold text-[10px] sm:text-xs hover:border-slate-600 transition';
                    badge.className = 'flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-cyan-500/10 border border-cyan-500/20 text-cyan-400 text-[10px] sm:text-xs font-semibold';
                    badge.innerHTML = '<span class="w-2 h-2 rounded-full bg-cyan-400 animate-ping"></span> MANUAL AIM';
                }
                
                if (data.is_recording) {
                    vidContainer.className = 'glass rounded-2xl overflow-hidden relative border border-red-500 glow-red transition-all duration-300';
                    camLabel.innerHTML = '<span class="text-red-400 animate-pulse">RECORDING DVR HIGHLIGHT</span>';
                } else {
                    vidContainer.className = 'glass rounded-2xl overflow-hidden relative border border-slate-800 glow-cyan transition-all duration-300';
                    camLabel.innerText = 'FIXED ROOM KINEMATICS FEED';
                }

                document.getElementById('top-vel').innerText = data.top_sprint_mps;
                document.getElementById('avg-vel').innerText = data.avg_sprint_mps;
                document.getElementById('min-vel').innerText = (data.min_sprint_mps === 99.9) ? "0.0" : data.min_sprint_mps;
                
                document.getElementById('last-lap').innerText = data.last_lap_sec;
                
                if (data.fastest_lap_sec !== 99.9) {
                    document.getElementById('fastest-lap').innerText = data.fastest_lap_sec;
                    const unitEl = document.getElementById('fastest-lap-unit');
                    if (unitEl.classList.contains('hidden')) {
                        unitEl.classList.remove('hidden');
                    }
                }

                document.getElementById('treat-remaining').innerText = data.treats_remaining;

                velocityChart.data.datasets[0].data.push(data.current_velocity_mps);
                velocityChart.data.datasets[0].data.shift();
                velocityChart.update('none');
            } catch (e) {}
        }

        setInterval(syncTelemetry, 200);
    </script>
</body>
</html>
"""

