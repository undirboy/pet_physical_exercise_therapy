# ==========================================
# 2. DVR EXPORT THREAD
# ==========================================
def export_highlight_video(frames_to_save):
    # os.path.join handles Windows (\) vs Mac/Linux (/) slash differences automatically
    filename = os.path.join(highlight_dir, f"carbon_sprint_{int(time.time())}.mp4")
    fourcc = cv2.VideoWriter_fourcc(*'mp4v')
    out = cv2.VideoWriter(filename, fourcc, 30.0, (640, 480))
    for f in frames_to_save:
        out.write(f)
    out.release()
    print(f"[+] Highlight Saved to disk: {filename}")

