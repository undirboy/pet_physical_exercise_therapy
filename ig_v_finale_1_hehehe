    if request.method == 'POST':
        data = request.get_json() or {}
        dog_data = data.get("Dog", {})
        cat_data = data.get("Cat", {})
        human_data = data.get("Human", {})
        
        if dog_data: update_pet_profile_db("Dog", dog_data.get("name", "Carbon"), dog_data.get("birthday", ""))
        if cat_data: update_pet_profile_db("Cat", cat_data.get("name", "Kitty"), cat_data.get("birthday", ""))
        if human_data: update_pet_profile_db("Human", human_data.get("name", "Owner"), human_data.get("birthday", ""))
        
        return jsonify({"status": "updated"})
    with state_lock:
        return jsonify(pet_profiles)

@app.route('/api/turret/mode', methods=['POST'])
def toggle_mode():
    data = request.get_json() or {}
    mode = data.get("mode", "MANUAL")
    with state_lock: 
        telemetry_state["turret_mode"] = mode
        if mode == "HIIT_ROUTINE": telemetry_state["hiit_next_action_time"] = time.time() + 2.0
    return jsonify({"mode": mode})

@app.route('/api/turret/aim', methods=['POST'])
def aim_turret():
    data = request.get_json() or {}
    with state_lock:
        telemetry_state["turret_mode"] = "MANUAL" 
        telemetry_state["turret_angle_deg"] = int(data.get("angle", 90))
        telemetry_state["launch_distance_ft"] = int(data.get("distance", 6))
    return jsonify({"status": "AIMED"})

@app.route('/api/turret/fire', methods=['POST'])
