    with state_lock:
        telemetry_state["turret_mode"] = "MANUAL"
        trigger_launch_sequence(telemetry_state["turret_angle_deg"], telemetry_state["launch_distance_ft"])
    return jsonify({"status": "PRE_LAUNCH_INITIATED"})

@app.route('/api/turret/refill', methods=['POST'])
def refill_turret():
    with state_lock: telemetry_state["treats_remaining"] = MAX_TREAT_CAPACITY
    return jsonify({"status": "REFILLED"})

