def get_universal_arduino_port():
    for port in serial.tools.list_ports.comports():
        desc = port.description.lower()
        device = port.device.lower()
        if "arduino" in desc or "ch340" in desc or "cp210" in desc or "usbmodem" in device or "ttyacm" in device or "ttyusb" in device:
            return port.device
    return None

arduino_port = get_universal_arduino_port()
if arduino_port:
    try: arduino = serial.Serial(arduino_port, 9600, timeout=1, write_timeout=0)
    except Exception: arduino = None
else: arduino = None

def get_universal_camera():
    os_name = platform.system()
    cap = None
    if os_name == "Darwin": cap = cv2.VideoCapture(0, cv2.CAP_AVFOUNDATION)
    elif os_name == "Windows": cap = cv2.VideoCapture(0, cv2.CAP_DSHOW)
    elif os_name == "Linux": cap = cv2.VideoCapture(0, cv2.CAP_V4L2)
    if cap is None or not cap.isOpened(): cap = cv2.VideoCapture(0)
    if not cap.isOpened(): cap = cv2.VideoCapture(1)
    if cap.isOpened():
        cap.set(cv2.CAP_PROP_FRAME_WIDTH, 640)
        cap.set(cv2.CAP_PROP_FRAME_HEIGHT, 480)
        time.sleep(0.3)
    return cap

def trigger_launch_sequence(angle, distance):
    with state_lock:
        if not telemetry_state["is_pre_launch"] and telemetry_state["treats_remaining"] > 0:
            telemetry_state["turret_angle_deg"] = angle
            telemetry_state["launch_distance_ft"] = distance
            telemetry_state["is_pre_launch"] = True
            telemetry_state["pre_launch_timer"] = time.time()

def fire_hardware_turret():
    global arduino, telemetry_state
    if arduino:
        cmd = f"FIRE:{telemetry_state['turret_angle_deg']}:{telemetry_state['launch_distance_ft']}\n"
        try: arduino.write(cmd.encode())
        except: pass

# ==========================================
# 6. CORE VISION ENGINE
# ==========================================
def vision_thread_loop():
    global output_frame, telemetry_state, highlight_countdown
    
    cap = get_universal_camera()
    prev_gray = None
    prev_center_x = None
    inactivity_start_time = None
    last_tick_time = time.time()
    last_fall_time = time.time()
    auto_fire_timer = time.time()
    frame_count = 0
    
    last_pet_seen_time = 0.0
    current_pet_type = "None"
    pet_confirmed = False if ai_net else True
    
    PIXEL_TO_METER_SCALE = 0.005

    while True:
        if not cap.isOpened():
            time.sleep(1.0)
            cap = get_universal_camera()
            continue

        ret, frame = cap.read()
        if not ret or frame is None:
            time.sleep(0.03)
            continue
            
        frame = cv2.resize(frame, (640, 480))
        now = time.time()
        dt = now - last_tick_time
        last_tick_time = now if dt > 0.001 else last_tick_time + 0.001
        frame_count += 1

        frame = cv2.flip(frame, 1)
        curr_gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)
        
        avg_brightness = np.mean(curr_gray)
        is_night = avg_brightness < 25.0
        with state_lock:
            telemetry_state["night_mode"] = is_night

        curr_gray = cv2.GaussianBlur(curr_gray, (21, 21), 0)
        
        with frame_lock:
            rolling_frame_buffer.append(frame.copy())

        trigger_db_update = False

        if prev_gray is not None and not is_night:
            frame_diff = cv2.absdiff(prev_gray, curr_gray)
            thresh = cv2.threshold(frame_diff, 25, 255, cv2.THRESH_BINARY)[1]
            
            motion_pixels = float(np.sum(thresh > 0))
            total_pixels = frame.shape[0] * frame.shape[1]
            motion_ratio = (motion_pixels / total_pixels) * 100.0

            if ai_net and motion_ratio > 0.5 and frame_count % 5 == 0:
                blob = cv2.dnn.blobFromImage(cv2.resize(frame, (300, 300)), 0.007843, (300, 300), 127.5)
                ai_net.setInput(blob)
                detections = ai_net.forward()
                
                for i in range(detections.shape[2]):
                    confidence = detections[0, 0, i, 2]
                    if confidence > 0.4:
                        class_id = int(detections[0, 0, i, 1])
                        if class_id == 12: # Dog
                            last_pet_seen_time = now
                            current_pet_type = "Dog"
                            break
                        elif class_id == 8: # Cat
                            last_pet_seen_time = now
                            current_pet_type = "Cat"
                            break
                        elif class_id == 15: # Person/Human
                            last_pet_seen_time = now
                            current_pet_type = "Human"
                            break
            
            if ai_net:
                pet_confirmed = (now - last_pet_seen_time) < 2.0
                if not pet_confirmed:
                    current_pet_type = "None"
                    
                with state_lock: 
                    telemetry_state["pet_detected_ai"] = pet_confirmed
                    telemetry_state["pet_detected_type"] = current_pet_type

            with state_lock:
                if motion_ratio < 0.8:
                    if inactivity_start_time is None: inactivity_start_time = now
                    elif (now - inactivity_start_time) > 3.0:
                        telemetry_state["is_sleeping"] = True
                        telemetry_state["sleep_duration_sec"] += dt
                else:
                    inactivity_start_time = None
                    telemetry_state["is_sleeping"] = False

                if motion_ratio > 35.0 and pet_confirmed and (now - last_fall_time > 4.0):
                    telemetry_state["fall_count"] += 1
                    last_fall_time = now
                    trigger_db_update = True
                    if highlight_countdown == 0: highlight_countdown = 75 

                if telemetry_state["is_pre_launch"]:
                    if now - telemetry_state["pre_launch_timer"] > 3.0:
                        telemetry_state["is_pre_launch"] = False
                        telemetry_state["treats_remaining"] -= 1
                        telemetry_state["treat_level_pct"] = int((telemetry_state["treats_remaining"] / MAX_TREAT_CAPACITY) * 100)
                        telemetry_state["fetch_active"] = True
                        telemetry_state["fetch_start_time"] = now
                        fire_hardware_turret()
                        auto_fire_timer = now 

                if not telemetry_state["is_pre_launch"]:
                    mode = telemetry_state["turret_mode"]
                    if mode == "AUTO_LURE":
                        if telemetry_state["bark_detected"] and (now - auto_fire_timer > 3.0): 
                            trigger_launch_sequence(random.randint(30, 150), random.randint(4, 9))
                        elif not telemetry_state["is_sleeping"] and (now - auto_fire_timer > 8.0): 
                            trigger_launch_sequence(random.randint(30, 150), random.randint(4, 9))
                            
                    elif mode == "HIIT_ROUTINE":
                        if now > telemetry_state["hiit_next_action_time"]:
                            dist = 3 if telemetry_state["hiit_step"] % 2 == 0 else 10
                            telemetry_state["hiit_step"] += 1
                            telemetry_state["hiit_next_action_time"] = now + 10.0 
                            trigger_launch_sequence(90, dist)

            contours, _ = cv2.findContours(thresh, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)
            
            if contours and pet_confirmed:
                largest_cnt = max(contours, key=cv2.contourArea)
                if cv2.contourArea(largest_cnt) > 800:
                    M = cv2.moments(largest_cnt)
                    if M["m00"] != 0:
                        curr_center_x = int(M["m10"] / M["m00"])
                        
                        if prev_center_x is not None and dt > 0:
                            dx_pixels = abs(curr_center_x - prev_center_x)
                            velocity_mps = round((dx_pixels * PIXEL_TO_METER_SCALE) / dt, 2)
                            
                            if velocity_mps < 15.0:
                                with state_lock:
                                    telemetry_state["current_velocity_mps"] = velocity_mps
                                    if velocity_mps > telemetry_state["top_sprint_mps"]:
                                        telemetry_state["top_sprint_mps"] = velocity_mps
                                        trigger_db_update = True
                                    if velocity_mps > 0.2:
                                        telemetry_state["sprint_sum"] += velocity_mps
                                        telemetry_state["sprint_count"] += 1
                                        telemetry_state["avg_sprint_mps"] = round(telemetry_state["sprint_sum"] / telemetry_state["sprint_count"], 2)
                                        if velocity_mps < telemetry_state["min_sprint_mps"]: 
                                            telemetry_state["min_sprint_mps"] = velocity_mps
                                    if velocity_mps > 3.0 and highlight_countdown == 0: 
                                        highlight_countdown = 75
                        
                        prev_center_x = curr_center_x
                else:
                    with state_lock: telemetry_state["current_velocity_mps"] = 0.0
                    prev_center_x = None
            else:
                with state_lock: telemetry_state["current_velocity_mps"] = 0.0
                prev_center_x = None
                    
        elif is_night:
            with state_lock: telemetry_state["current_velocity_mps"] = 0.0
            prev_center_x = None

        with state_lock:
            if telemetry_state["fetch_active"]:
                lap_elapsed = now - telemetry_state["fetch_start_time"]
                if lap_elapsed > 2.0 and telemetry_state["current_velocity_mps"] < 0.5:
                    telemetry_state["last_lap_sec"] = round(lap_elapsed, 1)
                    if telemetry_state["fastest_lap_sec"] == 99.9 or telemetry_state["last_lap_sec"] < telemetry_state["fastest_lap_sec"]:
                        telemetry_state["fastest_lap_sec"] = telemetry_state["last_lap_sec"]
                        trigger_db_update = True
                    telemetry_state["fetch_active"] = False

            if highlight_countdown > 0:
                telemetry_state["is_recording"] = True
                highlight_countdown -= 1
                if highlight_countdown == 0:
                    with frame_lock:
                        frames_to_save = list(rolling_frame_buffer)
                    threading.Thread(target=export_highlight_video, args=(frames_to_save,)).start()
            else:
                telemetry_state["is_recording"] = False

        if trigger_db_update: update_db_stats()
        prev_gray = curr_gray

        with state_lock:
            velocity_val = telemetry_state['current_velocity_mps']
            mode_val = telemetry_state['turret_mode']
            fall_val = telemetry_state['fall_count']
            night = telemetry_state['night_mode']
            angle_val = telemetry_state['turret_angle_deg']
            dist_val = telemetry_state['launch_distance_ft']
            ai_flag = telemetry_state['pet_detected_ai']
            p_type = telemetry_state['pet_detected_type']

        cam_bottom_x = int(frame.shape[1] / 2)
        cam_bottom_y = frame.shape[0] - 10
        math_angle = math.radians(180 - angle_val)
        line_length = dist_val * 25
        target_x = int(cam_bottom_x + math.cos(math_angle) * line_length)
        target_y = int(cam_bottom_y - math.sin(math_angle) * line_length)
        
        cv2.line(frame, (cam_bottom_x, cam_bottom_y), (target_x, target_y), (0, 255, 255), 2)
        cv2.circle(frame, (target_x, target_y), 15, (0, 165, 255), 2)
        
        cv2.rectangle(frame, (10, 10), (450, 110), (0, 0, 0), -1)
        mode_color = (255, 0, 255) if night else ((0, 255, 136) if mode_val != 'MANUAL' else (255, 200, 0))
        cv2.putText(frame, f"MODE: {'NIGHT STANDBY' if night else mode_val}", (20, 35), cv2.FONT_HERSHEY_SIMPLEX, 0.55, mode_color, 2)
        cv2.putText(frame, f"FETCH VELOCITY: {velocity_val} m/s", (20, 65), cv2.FONT_HERSHEY_SIMPLEX, 0.55, (0, 242, 254), 2)
        cv2.putText(frame, f"DB LOGS | FALLS: {fall_val}", (20, 95), cv2.FONT_HERSHEY_SIMPLEX, 0.55, (0, 255, 0), 2)

        if ai_net and ai_flag and p_type != "None":
            with state_lock: custom_name = pet_profiles.get(p_type, {}).get("name", p_type).upper()
            if p_type == 'Cat': box_color = (0, 165, 255)
            elif p_type == 'Human': box_color = (0, 255, 0)
            else: box_color = (255, 0, 255)
            cv2.putText(frame, f"[{custom_name} ACQUIRED]", (450, 95), cv2.FONT_HERSHEY_SIMPLEX, 0.45, box_color, 1)

        if recording and int(time.time() * 4) % 2 == 0:
            cv2.circle(frame, (600, 30), 8, (0, 0, 255), -1)
            cv2.putText(frame, "REC", (550, 35), cv2.FONT_HERSHEY_SIMPLEX, 0.5, (0, 0, 255), 2)

        with frame_lock: output_frame = frame.copy()
        time.sleep(0.03)

