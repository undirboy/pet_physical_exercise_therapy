        }
        async function updateAim() { await fetch('/api/turret/aim', { method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify({angle: document.getElementById('angle-slider').value, distance: document.getElementById('dist-slider').value}) }); }
        
        async function fireTurret() { 
            initAudio();
            await fetch('/api/turret/fire', { method: 'POST' }); 
        }
        async function refillTurret() { await fetch('/api/turret/refill', { method: 'POST' }); }

        let previousMode = 'MANUAL';
        let wasPreLaunch = false;

        async function syncTelemetry() {
            try {
                const res = await fetch('/api/telemetry');
                const data = await res.json();
                
                const manualBtn = document.getElementById('btn-manual');
                const autoBtn = document.getElementById('btn-auto');
                const hiitBtn = document.getElementById('btn-hiit');
                const badge = document.getElementById('mode-badge');
                const vidContainer = document.getElementById('video-container');
                const camLabel = document.getElementById('camera-label');
                const aiBadge = document.getElementById('ai-badge');
                const fireBtn = document.getElementById('btn-fire');
                
                // Fixed Button State Management
                if (data.treats_remaining <= 0) {
                    fireBtn.innerHTML = '<i data-lucide="x-circle" class="w-5 h-5 fill-slate-800"></i> HOPPER EMPTY';
                    fireBtn.className = 'w-full py-4 px-4 bg-slate-800 text-slate-500 font-extrabold rounded-xl transition flex items-center justify-center gap-2 cursor-not-allowed';
                    fireBtn.disabled = true;
                    lucide.createIcons();
                } else if (data.is_pre_launch && !wasPreLaunch) {
                    playSiren();
                    fireBtn.innerHTML = '<i data-lucide="alert-triangle" class="w-5 h-5 fill-black"></i> STAND CLEAR - LAUNCHING';
                    fireBtn.className = 'w-full py-4 px-4 bg-red-500 text-black font-extrabold rounded-xl transition shadow-lg shadow-red-500/50 flex items-center justify-center gap-2 animate-pulse';
                    fireBtn.disabled = true;
                    lucide.createIcons();
                } else if (!data.is_pre_launch && (wasPreLaunch || fireBtn.disabled)) {
                    fireBtn.innerHTML = '<i data-lucide="zap" class="w-5 h-5 fill-black"></i> INITIATE LAUNCH';
                    fireBtn.className = 'w-full py-4 px-4 bg-gradient-to-r from-amber-500 to-orange-500 text-black font-extrabold rounded-xl transition shadow-lg shadow-amber-500/20 flex items-center justify-center gap-2 active:scale-95';
                    fireBtn.disabled = false;
                    lucide.createIcons();
                }
                wasPreLaunch = data.is_pre_launch;

                const activeBtnClass = 'py-2 px-2 rounded-xl border border-emerald-500/40 bg-emerald-500/20 text-emerald-300 font-semibold text-[10px] transition active:scale-95';
                const inactiveBtnClass = 'py-2 px-2 rounded-xl border border-slate-700 bg-slate-800 text-slate-400 font-semibold text-[10px] hover:border-slate-600 transition active:scale-95';

                if (data.turret_mode === 'AUTO_LURE') {
                    autoBtn.className = activeBtnClass; manualBtn.className = inactiveBtnClass; hiitBtn.className = inactiveBtnClass;
                    badge.innerHTML = '<span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span> AUTO LURE PATROL';
                    document.getElementById('angle-slider').value = data.turret_angle_deg;
                    document.getElementById('dist-slider').value = data.launch_distance_ft;
                    updateAimText();
                } else if (data.turret_mode === 'HIIT_ROUTINE') {
                    hiitBtn.className = 'py-2 px-2 rounded-xl border border-purple-500/40 bg-purple-500/20 text-purple-300 font-semibold text-[10px] transition active:scale-95';
                    manualBtn.className = inactiveBtnClass; autoBtn.className = inactiveBtnClass;
                    badge.innerHTML = '<span class="w-2 h-2 rounded-full bg-purple-400 animate-ping"></span> HIIT WORKOUT';
                } else {
                    manualBtn.className = 'py-2 px-2 rounded-xl border border-cyan-500/40 bg-cyan-500/20 text-cyan-300 font-semibold text-[10px] transition active:scale-95';
                    autoBtn.className = inactiveBtnClass; hiitBtn.className = inactiveBtnClass;
                    badge.innerHTML = '<span class="w-2 h-2 rounded-full bg-cyan-400 animate-ping"></span> MANUAL AIM';
                }
                
                if (data.is_pre_launch) {
                    vidContainer.className = 'glass rounded-2xl overflow-hidden relative border border-orange-500 glow-orange transition-all duration-300';
                    camLabel.innerHTML = '<span class="text-orange-400 font-bold">PAVLOVIAN PROTOCOL ACTIVE</span>';
                } else if (data.is_recording) {
                    vidContainer.className = 'glass rounded-2xl overflow-hidden relative border border-red-500 glow-red transition-all duration-300';
                    camLabel.innerHTML = '<span class="text-red-400 animate-pulse">RECORDING DVR HIGHLIGHT</span>';
                } else {
                    vidContainer.className = 'glass rounded-2xl overflow-hidden relative border border-slate-800 glow-cyan transition-all duration-300';
                    camLabel.innerText = 'FIXED ROOM KINEMATICS FEED';
                }

                if (data.pet_detected_ai && data.pet_detected_type !== "None") {
                    let pType = data.pet_detected_type;
                    let pName = currentProfiles[pType] ? currentProfiles[pType].name.toUpperCase() : pType.toUpperCase();
                    
                    let iconColor = pType === 'Cat' ? 'text-amber-400' : (pType === 'Human' ? 'text-emerald-400' : 'text-cyan-400');
                    let borderColor = pType === 'Cat' ? 'border-amber-500/50 bg-amber-500/20' : (pType === 'Human' ? 'border-emerald-500/50 bg-emerald-500/20' : 'border-cyan-500/50 bg-cyan-500/20');
                    let iconName = pType === 'Human' ? 'user' : 'brain';
                    
                    aiBadge.innerHTML = `<i data-lucide="${iconName}" class="w-3 h-3"></i> AI: ${pName} ACQUIRED`;
                    aiBadge.className = `hidden md:flex items-center gap-1.5 px-3 py-1.5 rounded-full ${borderColor} ${iconColor} text-[10px] mono`;
                    lucide.createIcons();
                } else {
                    aiBadge.innerHTML = '<i data-lucide="brain" class="w-3 h-3"></i> AI: SEARCHING...';
                    aiBadge.className = 'hidden md:flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-slate-800 border border-slate-700 text-slate-400 text-[10px] mono';
                    lucide.createIcons();
                }

                document.getElementById('top-vel').innerText = data.top_sprint_mps;
                document.getElementById('avg-vel').innerText = data.avg_sprint_mps;
                document.getElementById('min-vel').innerText = data.min_sprint_mps == 99.9 ? '0.0' : data.min_sprint_mps;
                
                document.getElementById('last-lap').innerText = data.last_lap_sec;
                if (data.fastest_lap_sec !== 99.9) {
                    document.getElementById('fastest-lap').innerText = data.fastest_lap_sec;
                    const unitEl = document.getElementById('fastest-lap-unit');
                    if (unitEl.classList.contains('hidden')) unitEl.classList.remove('hidden');
                }

                document.getElementById('treat-remaining').innerText = data.treats_remaining;

                velocityChart.data.datasets[0].data.push(data.current_velocity_mps);
                velocityChart.data.datasets[0].data.shift();
                velocityChart.update('none');
            } catch (e) {}
        }
        setInterval(syncTelemetry, 200);
    </script>
</body>
</html>
"""

