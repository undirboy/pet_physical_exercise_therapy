def get_camera_for_mode(cam_mode):
    os_name = platform.system()
    target_indices = [2, 1, 0] if cam_mode == "360_PANORAMIC" else ([1, 2, 0] if cam_mode == "EXTENDED" else [0, 1, 2])

    for idx in target_indices:
        cap = cv2.VideoCapture(idx, cv2.CAP_AVFOUNDATION if os_name == "Darwin" else (cv2.CAP_DSHOW if os_name == "Windows" else cv2.CAP_V4L2))
        if cap is not None and cap.isOpened():
            ret, test_frame = cap.read()
            if ret and test_frame is not None:
                cap.set(cv2.CAP_PROP_FRAME_WIDTH, 1280 if cam_mode == "360_PANORAMIC" else 640)
                cap.set(cv2.CAP_PROP_FRAME_HEIGHT, 640 if cam_mode == "360_PANORAMIC" else 480)
                return cap
            else: cap.release()
    return cv2.VideoCapture(0)

def fire_hardware_turret():
    global arduino, telemetry_state
    if arduino:
        cmd = f"FIRE:{telemetry_state['turret_angle_deg']}:{telemetry_state['launch_distance_ft']}\n"
        try: arduino.write(cmd.encode())
        except: pass

def trigger_launch_sequence(angle, distance, is_auto=False):
    with state_lock:
        if telemetry_state["treats_remaining"] > 0:
            telemetry_state["turret_angle_deg"] = angle
            telemetry_state["launch_distance_ft"] = distance
            if is_auto:
                if not telemetry_state["is_pre_launch"]:
                    telemetry_state["is_pre_launch"] = 1
                    telemetry_state["pre_launch_timer"] = time.time()
                    
                    telemetry_state["buzzer_timestamp"] = time.time()
                    telemetry_state["waiting_for_reaction"] = True
            else:
                telemetry_state["treats_remaining"] -= 1
                telemetry_state["treats_dispensed_today"] += 1
                telemetry_state["fetch_active"] = 1
                telemetry_state["fetch_start_time"] = time.time()
                fire_hardware_turret()

def turret_logic_thread():
    auto_fire_timer = time.time()
    while True:
        now = time.time()
        trigger_db_update = False
        with state_lock:
            if telemetry_state["is_pre_launch"]:
                if now - telemetry_state["pre_launch_timer"] > 3.0:
                    telemetry_state["is_pre_launch"] = 0
                    if telemetry_state["treats_remaining"] > 0:
                        telemetry_state["treats_remaining"] -= 1
                        telemetry_state["treats_dispensed_today"] += 1
                        telemetry_state["fetch_active"] = 1
                        telemetry_state["fetch_start_time"] = now
                        fire_hardware_turret()
                    auto_fire_timer = now 
                    trigger_db_update = True

            if not telemetry_state["is_pre_launch"]:
                mode = telemetry_state["turret_mode"]
                if mode == "AUTO_LURE":
                    if telemetry_state["bark_detected"] and (now - auto_fire_timer > 3.0): 
                        trigger_launch_sequence(random.randint(30, 150), random.randint(4, 9), is_auto=True)
                    elif not telemetry_state["is_sleeping"] and (now - auto_fire_timer > 8.0): 
                        trigger_launch_sequence(random.randint(30, 150), random.randint(4, 9), is_auto=True)
                elif mode == "HIIT_ROUTINE":
                    if now > telemetry_state["hiit_next_action_time"]:
                        dist = 3 if telemetry_state["hiit_step"] % 2 == 0 else 10
                        telemetry_state["hiit_step"] += 1
                        telemetry_state["hiit_next_action_time"] = now + 10.0 
                        trigger_launch_sequence(90, dist, is_auto=True)

            if telemetry_state["fetch_active"] and (now - telemetry_state["fetch_start_time"] > 20.0):
                telemetry_state["fetch_active"] = 0

        if trigger_db_update: update_db_stats()
        time.sleep(0.1)

