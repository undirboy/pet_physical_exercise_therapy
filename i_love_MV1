def init_db():
    conn = sqlite3.connect(DB_PATH, check_same_thread=False)
    c = conn.cursor()
    c.execute('''CREATE TABLE IF NOT EXISTS daily_stats (date TEXT PRIMARY KEY, top_speed REAL, fastest_lap REAL, falls INTEGER)''')
    try: c.execute("ALTER TABLE daily_stats ADD COLUMN treats INTEGER DEFAULT 0")
    except: pass
    try: c.execute("ALTER TABLE daily_stats ADD COLUMN limp_delta_val REAL DEFAULT 0.0")
    except: pass
        
    c.execute('''CREATE TABLE IF NOT EXISTS telemetry_logs (id INTEGER PRIMARY KEY AUTOINCREMENT, timestamp TEXT, event_type TEXT, details TEXT)''')
        
    c.execute('''CREATE TABLE IF NOT EXISTS profiles (species TEXT PRIMARY KEY, name TEXT, birthday TEXT)''')
    try: c.execute("ALTER TABLE profiles ADD COLUMN breed TEXT DEFAULT ''")
    except: pass
    try: c.execute("ALTER TABLE profiles ADD COLUMN weight REAL DEFAULT 0.0")
    except: pass
    
    c.execute("INSERT OR IGNORE INTO profiles (species, name, birthday, breed, weight) VALUES ('Dog', 'Carbon', '', '', 0.0)")
    c.execute("INSERT OR IGNORE INTO profiles (species, name, birthday, breed, weight) VALUES ('Cat', 'Kitty', '', '', 0.0)")
    c.execute("INSERT OR IGNORE INTO profiles (species, name, birthday, breed, weight) VALUES ('Human', 'Owner', '', '', 0.0)")
    conn.commit()
