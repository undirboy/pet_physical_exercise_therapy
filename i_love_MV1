def update_dynamic_baseline():
    dog = pet_profiles.get("Dog", {})
    breed = str(dog.get("breed", "")).lower()
    bday = dog.get("birthday", "")
    weight = float(dog.get("weight", 0.0) or 0.0)

    breed_speeds = {"greyhound": 8.0, "border collie": 6.5, "labrador": 5.0, "retriever": 4.5, "bulldog": 2.5, "pug": 2.0}
    base_spd = 3.5 
    base_rx = 0.5  
    
    for k, v in breed_speeds.items():
        if k in breed:
            base_spd = v
            break

    try:
        if bday:
            b_year = int(bday.split("-")[0])
            age = date.today().year - b_year
            if age >= 8: 
                base_spd *= 0.85
                base_rx += 0.4 
            elif age >= 5:
                base_rx += 0.2
    except: pass

    if weight > 35.0:
        base_spd *= 0.90

    with state_lock:
        telemetry_state["active_baseline_mps"] = round(base_spd, 2)
        telemetry_state["expected_reaction_sec"] = round(base_rx, 2)

def load_db_stats():
    today = str(date.today())
    conn = sqlite3.connect(DB_PATH, check_same_thread=False)
    c = conn.cursor()
    try:
        c.execute("SELECT top_speed, fastest_lap, falls, treats, limp_delta_val FROM daily_stats WHERE date=?", (today,))
        row = c.fetchone()
        if row:
            with state_lock:
                telemetry_state["top_sprint_mps"] = row[0]
                telemetry_state["fastest_lap_sec"] = row[1]
                telemetry_state["fall_count"] = row[2] if row[2] is not None else 0
                telemetry_state["treats_dispensed_today"] = row[3] if row[3] is not None else 0
                telemetry_state["limp_delta"] = row[4] if row[4] is not None else 0.0
                
        c.execute("SELECT limp_delta_val FROM daily_stats WHERE date < ? ORDER BY date DESC LIMIT 1", (today,))
        prev_row = c.fetchone()
        if prev_row and prev_row[0] is not None:
            with state_lock:
                telemetry_state["prev_day_asymmetry"] = prev_row[0]
    except Exception:
        pass
        
    try:
        c.execute("SELECT species, name, birthday, breed, weight FROM profiles")
        for row in c.fetchall():
            with state_lock:
                pet_profiles[row[0]] = {"name": row[1], "birthday": row[2], "breed": row[3], "weight": row[4]}
    except Exception:
        pass
    conn.close()
    update_dynamic_baseline()

def update_db_stats():
    today = str(date.today())
    with state_lock:
        top = telemetry_state["top_sprint_mps"]
        lap = telemetry_state["fastest_lap_sec"]
        falls = telemetry_state["fall_count"]
        treats = telemetry_state["treats_dispensed_today"]
        limp_val = telemetry_state["limp_delta"]

    max_retries = 5
    for attempt in range(max_retries):
        conn = None
        try:
            conn = sqlite3.connect(DB_PATH, check_same_thread=False)
            c = conn.cursor()
            c.execute("""INSERT OR REPLACE INTO daily_stats (date, top_speed, fastest_lap, falls, treats, limp_delta_val) 
                         VALUES (?, ?, ?, ?, ?, ?)""", (today, top, lap, falls, treats, limp_val))
            conn.commit()
            break
        except sqlite3.OperationalError: time.sleep(0.1)
        except Exception: break
        finally:
            if conn is not None:
                conn.close()

