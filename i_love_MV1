def init_ai_model():
    proto = os.path.join(BASE_DIR, "MobileNetSSD.prototxt")
    model = os.path.join(BASE_DIR, "MobileNetSSD.caffemodel")
    
    if os.path.exists(proto) and os.path.exists(model):
        try:
            net = cv2.dnn.readNetFromCaffe(proto, model)
            print("[+] Neural Network Entity Detection Loaded from local files.")
            return net
        except Exception:
            pass

    print("[*] Downloading MobileNet-SSD AI Models...")
    try:
        urllib.request.urlretrieve("https://raw.githubusercontent.com/chuanqi305/MobileNet-SSD/master/voc/MobileNetSSD_deploy.prototxt", proto)
        urllib.request.urlretrieve("https://raw.githubusercontent.com/chuanqi305/MobileNet-SSD/master/voc/MobileNetSSD_deploy.caffemodel", model)
        
        if os.path.getsize(model) < 1000000:
            if os.path.exists(proto): os.remove(proto)
            if os.path.exists(model): os.remove(model)
            return None
            
        net = cv2.dnn.readNetFromCaffe(proto, model)
        print("[+] Neural Network Entity Detection Loaded.")
        return net
    except Exception as e:
        print(f"[-] AI Download failed: {e}. Running on standard motion tracking.")
        return None

ai_net = init_ai_model()

