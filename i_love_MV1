# ==========================================
def vision_thread_loop():
    global output_frame, telemetry_state, last_security_alert_time
    current_cam_mode = "LAPTOP"
    cap = get_camera_for_mode(current_cam_mode)
    
    prev_gray = None
    inactivity_start_time = None
    last_tick_time = time.time()
    last_fall_time = time.time()
    frame_count = 0
    last_pet_seen_time = 0.0
    current_pet_type = "None"

    while True:
        with state_lock:
            target_cam_mode = telemetry_state.get("camera_mode", "LAPTOP")
            active_base = telemetry_state["active_baseline_mps"]

        if target_cam_mode != current_cam_mode or cap is None or not cap.isOpened():
            if cap is not None: cap.release()
            current_cam_mode = target_cam_mode
            cap = get_camera_for_mode(current_cam_mode)
            prev_gray = None

        if cap is None or not cap.isOpened():
            time.sleep(1.0)
            continue

        ret, frame = cap.read()
        if not ret or frame is None:
            time.sleep(0.03)
            continue
            
        if current_cam_mode == "360_PANORAMIC":
            frame = cv2.resize(frame, (1280, 640))
            PIXEL_TO_METER_SCALE = 0.008  
        else:
            frame = cv2.resize(frame, (640, 480))
            PIXEL_TO_METER_SCALE = 0.035  

        now = time.time()
        dt = now - last_tick_time
        last_tick_time = now if dt > 0.001 else last_tick_time + 0.001
        frame_count += 1

        frame = cv2.flip(frame, 1)
        curr_gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)
        
        avg_brightness = np.mean(curr_gray)
        is_night = 1 if avg_brightness < 25.0 else 0
        with state_lock: telemetry_state["night_mode"] = is_night

        curr_gray = cv2.GaussianBlur(curr_gray, (21, 21), 0)
        trigger_db_update = False

        if prev_gray is not None and not is_night:
            frame_diff = cv2.absdiff(prev_gray, curr_gray)
            thresh = cv2.threshold(frame_diff, 25, 255, cv2.THRESH_BINARY)[1]
            
            motion_pixels = float(np.sum(thresh > 0))
            total_pixels = frame.shape[0] * frame.shape[1]
            motion_ratio = (motion_pixels / total_pixels) * 100.0

            if ai_net and motion_ratio > 0.5 and frame_count % 5 == 0:
                blob = cv2.dnn.blobFromImage(cv2.resize(frame, (300, 300)), 0.007843, (300, 300), 127.5)
                ai_net.setInput(blob)
                detections = ai_net.forward()
                
                detected_any = False
                for i in range(detections.shape[2]):
                    confidence = detections[0, 0, i, 2]
                    if confidence > 0.4:
                        class_id = int(detections[0, 0, i, 1])
                        if class_id in [8, 12, 15]:
                            last_pet_seen_time = now
                            current_pet_type = "Dog" if class_id == 12 else ("Cat" if class_id == 8 else "Human")
                            detected_any = True
                            box = detections[0, 0, i, 3:7] * np.array([frame.shape[1], frame.shape[0], frame.shape[1], frame.shape[0]])
                            (startX, startY, endX, endY) = box.astype("int")
                            box_color = (0, 0, 255) if class_id == 15 else (0, 255, 0)
                            label = f"AI LOCK: {current_pet_type} ({confidence * 100:.1f}%)"
                            cv2.rectangle(frame, (startX, startY), (endX, endY), box_color, 2)
                            cv2.putText(frame, label, (startX, startY - 10), cv2.FONT_HERSHEY_SIMPLEX, 0.5, box_color, 2)
                            break
                if not detected_any and (now - last_pet_seen_time) > 2.0:
                    current_pet_type = "Motion Target"

            with state_lock:
                if motion_ratio < 0.8:
                    if inactivity_start_time is None: inactivity_start_time = now
                    elif (now - inactivity_start_time) > 3.0:
                        telemetry_state["is_sleeping"] = 1
                        telemetry_state["sleep_duration_sec"] += dt
                else:
                    inactivity_start_time = None
                    telemetry_state["is_sleeping"] = 0

                if motion_ratio > 35.0 and (now - last_fall_time > 4.0):
                    telemetry_state["fall_count"] += 1
                    last_fall_time = now
                    trigger_db_update = True

                if telemetry_state.get("security_mode", False) and motion_ratio > 2.0 and (now - last_security_alert_time > 3.0):
                    telemetry_state["security_alert_triggered"] = True
                    last_security_alert_time = now
                    try:
                        conn = sqlite3.connect(DB_PATH, check_same_thread=False)
                        c = conn.cursor()
                        c.execute("INSERT INTO telemetry_logs (timestamp, event_type, details) VALUES (?, ?, ?)",
                                  (str(datetime.datetime.now()), 'SECURITY_ALERT', 'Unrecognized motion detected in security mode'))
                        conn.commit()
                        conn.close()
                    except Exception: pass

            velocity_mps = round((motion_ratio * PIXEL_TO_METER_SCALE * 10), 2)
            if velocity_mps > 12.0: velocity_mps = 12.0

            stride = 0.0
            if velocity_mps > 0.2:
                simulated_step_freq = 2.0 + (velocity_mps * 0.2)
                stride = round(velocity_mps / simulated_step_freq, 2)

            with state_lock:
                telemetry_state["current_velocity_mps"] = velocity_mps
                telemetry_state["current_stride_length_m"] = stride
                
                if telemetry_state["waiting_for_reaction"] and velocity_mps > 0.5:
                    reaction_time = now - telemetry_state["buzzer_timestamp"]
                    telemetry_state["cognitive_reaction_time_sec"] = round(reaction_time, 2)
                    telemetry_state["waiting_for_reaction"] = False
                
                if telemetry_state["fetch_active"] == 1:
                    active_move_time = now - telemetry_state["fetch_start_time"]
                    telemetry_state["last_lap_sec"] = round(active_move_time, 1)
                    if active_move_time > 1.0 and velocity_mps < 0.2:
                        final_lap = telemetry_state["last_lap_sec"]
                        if telemetry_state["fastest_lap_sec"] == 99.9 or final_lap < telemetry_state["fastest_lap_sec"]:
                            telemetry_state["fastest_lap_sec"] = final_lap
                            trigger_db_update = True
                        telemetry_state["fetch_active"] = 0

                if velocity_mps > telemetry_state["top_sprint_mps"]:
                    telemetry_state["top_sprint_mps"] = velocity_mps
                    trigger_db_update = True
                    
                if velocity_mps > 1.5:
                    telemetry_state["sprint_sum"] += velocity_mps
                    telemetry_state["sprint_count"] += 1
                    telemetry_state["avg_sprint_mps"] = round(telemetry_state["sprint_sum"] / telemetry_state["sprint_count"], 2)
                    
                    if telemetry_state["avg_sprint_mps"] > 0:
                        delta = ((telemetry_state["avg_sprint_mps"] - active_base) / active_base) * 100
                        telemetry_state["limp_delta"] = round(delta, 1)
                        telemetry_state["limp_trend"] = round(telemetry_state["limp_delta"] - telemetry_state["prev_day_asymmetry"], 1)

                if velocity_mps < telemetry_state["min_sprint_mps"]: 
                    telemetry_state["min_sprint_mps"] = velocity_mps
        else:
            with state_lock: 
                telemetry_state["current_velocity_mps"] = 0.0
                telemetry_state["current_stride_length_m"] = 0.0

        if trigger_db_update: update_db_stats()
        prev_gray = curr_gray

        with state_lock:
            velocity_val = telemetry_state['current_velocity_mps']
            mode_val = telemetry_state['turret_mode']
            angle_val = telemetry_state['turret_angle_deg']
            dist_val = telemetry_state['launch_distance_ft']
            stride_val = telemetry_state['current_stride_length_m']
            night = telemetry_state['night_mode']
            falls_val = telemetry_state['fall_count']
            sec_mode_active = telemetry_state['security_mode']

        cam_bottom_x = int(frame.shape[1] / 2)
        cam_bottom_y = frame.shape[0] - 10
        math_angle = math.radians(180 - angle_val)
        line_length = dist_val * 25
        target_x = int(cam_bottom_x + math.cos(math_angle) * line_length)
        target_y = int(cam_bottom_y - math.sin(math_angle) * line_length)
        
        cv2.line(frame, (cam_bottom_x, cam_bottom_y), (target_x, target_y), (0, 255, 255), 2)
        cv2.circle(frame, (target_x, target_y), 15, (0, 165, 255), 2)
        
        cv2.rectangle(frame, (10, 10), (460, 115), (0, 0, 0), -1)
        mode_color = (0, 0, 255) if sec_mode_active else ((255, 0, 255) if night else ((0, 255, 136) if mode_val != 'MANUAL' else (255, 200, 0)))
        status_text = "SECURITY ARMED 🚨" if sec_mode_active else ('NIGHT STANDBY' if night else mode_val)
        
        cv2.putText(frame, f"MODE: {status_text}", (20, 35), cv2.FONT_HERSHEY_SIMPLEX, 0.55, mode_color, 2)
        cv2.putText(frame, f"VEL: {velocity_val} m/s | STRIDE: {stride_val} m", (20, 65), cv2.FONT_HERSHEY_SIMPLEX, 0.55, (0, 242, 254), 2)
        cv2.putText(frame, f"FALLS DETECTED: {falls_val}", (20, 95), cv2.FONT_HERSHEY_SIMPLEX, 0.55, (0, 0, 255), 2)

        with frame_lock: output_frame = frame.copy()
        time.sleep(0.03)

# ==========================================
# 7. FLASK PWA & API ENDPOINTS
# ==========================================
def generate_mjpeg_stream():
    global output_frame
    while True:
        current_frame = None
        with frame_lock:
            if output_frame is not None: current_frame = output_frame.copy()
        
        if current_frame is None:
            time.sleep(0.02)
            continue
            
        ret, encoded_image = cv2.imencode(".jpg", current_frame)
        if not ret: continue
            
        yield (b'--frame\r\n'
               b'Content-Type: image/jpeg\r\n\r\n' + bytearray(encoded_image) + b'\r\n')
        time.sleep(0.03)

