# ==========================================
# 1. FLASK APP & THREAD-SAFE STATE
# ==========================================
app = Flask(__name__)

# Locks prevent Flask web workers from colliding with the OpenCV background thread
state_lock = threading.Lock()
frame_lock = threading.Lock()

MAX_TREAT_CAPACITY = 25

telemetry_state = {
    "gait_asymmetry": 8.2,
    "prev_day_asymmetry": 18.5,
    "limp_delta": -10.3,
