# ==========================================
# 3. CROSS-PLATFORM CAMERA SETUP
# ==========================================
def get_universal_camera():
    os_name = platform.system()
    if os_name == "Darwin":
        cap = cv2.VideoCapture(0, cv2.CAP_AVFOUNDATION)
    elif os_name == "Windows":
        cap = cv2.VideoCapture(0, cv2.CAP_DSHOW)
    else:
        cap = cv2.VideoCapture(0)

    # Fallback if primary is occupied
    if not cap.isOpened():
        cap = cv2.VideoCapture(1)

    # Enforce strict resolution on ANY camera to protect the UI layout
    if cap.isOpened():
        cap.set(cv2.CAP_PROP_FRAME_WIDTH, 640)
        cap.set(cv2.CAP_PROP_FRAME_HEIGHT, 480)
        time.sleep(0.3)
        
    return cap

# ==========================================
# 4. STATIONARY VISION ENGINE & AUTO-LURE
# ==========================================
def vision_thread_loop():
    global output_frame, telemetry_state, arduino
    
    cap = get_universal_camera()
    prev_gray = None
    prev_center_x = None
    inactivity_start_time = None
    last_tick_time = time.time()
    last_fall_time = time.time()
    auto_fire_timer = time.time()
    
    # Scale factor mapping pixels to meters for indoor living room tracking
    PIXEL_TO_METER_SCALE = 0.005

    while True:
        if not cap.isOpened():
            time.sleep(1.0)
            cap = get_universal_camera()
            continue

        ret, frame = cap.read()
        if not ret or frame is None:
            time.sleep(0.05)
            continue

        now = time.time()
        dt = now - last_tick_time
        # Prevent division-by-zero errors in extremely fast thread loops
        last_tick_time = now if dt > 0.001 else last_tick_time + 0.001

        # Process frame
        frame = cv2.flip(frame, 1)
        curr_gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)
        curr_gray = cv2.GaussianBlur(curr_gray, (21, 21), 0)

        if prev_gray is not None:
            frame_diff = cv2.absdiff(prev_gray, curr_gray)
            thresh = cv2.threshold(frame_diff, 25, 255, cv2.THRESH_BINARY)[1]
            
            motion_pixels = float(np.sum(thresh > 0))
            total_pixels = frame.shape[0] * frame.shape[1]
            motion_ratio = (motion_pixels / total_pixels) * 100.0

            with state_lock:
                # 1. SLEEP & INACTIVITY DETECTOR
                if motion_ratio < 0.8:
                    if inactivity_start_time is None:
                        inactivity_start_time = now
                    elif (now - inactivity_start_time) > 3.0:
                        telemetry_state["is_sleeping"] = True
                        telemetry_state["sleep_duration_sec"] += dt
                else:
                    inactivity_start_time = None
                    telemetry_state["is_sleeping"] = False

                # 2. FALL DETECTOR
                if motion_ratio > 35.0 and (now - last_fall_time > 4.0):
                    telemetry_state["fall_count"] += 1
                    last_fall_time = now

                # 3. LIMP DELTA CALCULATION
                current_limp = telemetry_state["gait_asymmetry"]
                telemetry_state["limp_delta"] = round(current_limp - telemetry_state["prev_day_asymmetry"], 1)

                # 4. AUTONOMOUS AUTO-LURE PATROL
                if telemetry_state["turret_mode"] == "AUTO_LURE":
                    if not telemetry_state["is_sleeping"] and telemetry_state["treats_remaining"] > 0:
                        # Fire a treat every 8 seconds dynamically across the room
                        if now - auto_fire_timer > 8.0:
                            telemetry_state["turret_angle_deg"] = random.randint(30, 150)
                            telemetry_state["launch_distance_ft"] = random.randint(4, 9)
                            telemetry_state["treats_remaining"] -= 1
                            telemetry_state["treat_level_pct"] = int((telemetry_state["treats_remaining"] / MAX_TREAT_CAPACITY) * 100)
                            
                            # Fire Physical Hardware if connected
                            if arduino:
                                cmd = f"FIRE:{telemetry_state['turret_angle_deg']}:{telemetry_state['launch_distance_ft']}\n"
                                try:
                                    arduino.write(cmd.encode())
                                except Exception:
                                    pass
                                    
                            auto_fire_timer = now
                    else:
                        auto_fire_timer = now # Pause auto-timer if pet is sleeping or treats are empty

            # 5. SPRINT VELOCITY CENTROID TRACKER
            contours, _ = cv2.findContours(thresh, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)
            if contours:
                largest_cnt = max(contours, key=cv2.contourArea)
                if cv2.contourArea(largest_cnt) > 800:
                    M = cv2.moments(largest_cnt)
                    if M["m00"] != 0:
                        curr_center_x = int(M["m10"] / M["m00"])
                        
                        if prev_center_x is not None and dt > 0:
                            dx_pixels = abs(curr_center_x - prev_center_x)
                            distance_m = dx_pixels * PIXEL_TO_METER_SCALE
                            velocity_mps = round(distance_m / dt, 2)
                            
                            # Sanity check to prevent glitchy OpenCV light noise from recording 100 m/s
                            if velocity_mps < 15.0:
                                with state_lock:
                                    telemetry_state["current_velocity_mps"] = velocity_mps
                                    if velocity_mps > telemetry_state["top_sprint_mps"]:
                                        telemetry_state["top_sprint_mps"] = velocity_mps
                                    
                        prev_center_x = curr_center_x
            else:
                with state_lock:
                    telemetry_state["current_velocity_mps"] = 0.0

        prev_gray = curr_gray

        # HUD Overlay Rendering
        with state_lock:
            velocity_val = telemetry_state['current_velocity_mps']
            angle_val = telemetry_state['turret_angle_deg']
            dist_val = telemetry_state['launch_distance_ft']
            delta_val = telemetry_state['limp_delta']
            mode_val = telemetry_state['turret_mode']
            fall_val = telemetry_state['fall_count']

        cv2.rectangle(frame, (10, 10), (410, 150), (0, 0, 0), -1)
        cv2.putText(frame, f"MODE: {mode_val}", (20, 35), 
                    cv2.FONT_HERSHEY_SIMPLEX, 0.55, (0, 255, 136) if mode_val == 'AUTO_LURE' else (255, 200, 0), 2)
        cv2.putText(frame, f"FETCH VELOCITY: {velocity_val} m/s", (20, 65), 
                    cv2.FONT_HERSHEY_SIMPLEX, 0.55, (0, 242, 254), 2)
        cv2.putText(frame, f"TURRET PAN/DIST: {angle_val} deg / {dist_val} ft", (20, 95), 
                    cv2.FONT_HERSHEY_SIMPLEX, 0.55, (255, 200, 0), 2)
        
        delta_color = (0, 255, 0) if delta_val <= 0 else (0, 0, 255)
        cv2.putText(frame, f"LIMP DELTA: {delta_val}% | FALLS: {fall_val}", (20, 125), 
                    cv2.FONT_HERSHEY_SIMPLEX, 0.55, delta_color, 2)

        with frame_lock:
            output_frame = frame.copy()

        time.sleep(0.01) # CPU saver

# ==========================================
# 5. FLASK API ENDPOINTS
# ==========================================
def generate_mjpeg_stream():
    global output_frame
    while True:
        with frame_lock:
            if output_frame is None:
                time.sleep(0.02)
                continue
            ret, encoded_image = cv2.imencode(".jpg", output_frame)
            if not ret:
                continue
        yield (b'--frame\r\n'
               b'Content-Type: image/jpeg\r\n\r\n' + bytearray(encoded_image) + b'\r\n')

@app.route('/video_feed')
def video_feed():
    return Response(generate_mjpeg_stream(), mimetype='multipart/x-mixed-replace; boundary=frame')

@app.route('/api/telemetry')
def get_telemetry():
    with state_lock:
        return jsonify(telemetry_state)

@app.route('/api/turret/mode', methods=['POST'])
def toggle_mode():
    global telemetry_state
    data = request.get_json() or {}
    mode = data.get("mode", "MANUAL")
    with state_lock:
        telemetry_state["turret_mode"] = mode
    return jsonify({"mode": mode})

@app.route('/api/turret/aim', methods=['POST'])
def aim_turret():
    global telemetry_state
    data = request.get_json() or {}
    angle = data.get("angle", 90)
    distance = data.get("distance", 6)
    
    with state_lock:
        telemetry_state["turret_mode"] = "MANUAL" # Manual aim always overrides auto
        telemetry_state["turret_angle_deg"] = int(angle)
        telemetry_state["launch_distance_ft"] = int(distance)
        
    return jsonify({"status": "AIMED"})

@app.route('/api/turret/fire', methods=['POST'])
def fire_turret():
    global telemetry_state, arduino
    with state_lock:
        telemetry_state["turret_mode"] = "MANUAL" # Manual fire overrides auto
        if telemetry_state["treats_remaining"] > 0:
            telemetry_state["treats_remaining"] -= 1
            telemetry_state["treat_level_pct"] = int((telemetry_state["treats_remaining"] / MAX_TREAT_CAPACITY) * 100)
            status = "FIRED"
            
            # FIRE PHYSICAL HARDWARE
            if arduino:
                cmd = f"FIRE:{telemetry_state['turret_angle_deg']}:{telemetry_state['launch_distance_ft']}\n"
                try:
                    arduino.write(cmd.encode())
                except Exception:
                    pass
        else:
            status = "EMPTY"
    return jsonify({"status": status})

@app.route('/api/turret/refill', methods=['POST'])
def refill_turret():
    global telemetry_state
    with state_lock:
        telemetry_state["treats_remaining"] = MAX_TREAT_CAPACITY
        telemetry_state["treat_level_pct"] = 100
    return jsonify({"status": "REFILLED"})

